// Generic modal used for envelope messages
function openSimpleModal(icon,title,body,buttonText){
  document.getElementById('resultIcon').textContent=icon;
  document.getElementById('resultLabel').textContent='رسالة صغيرة إلك';
  document.getElementById('resultTitle').textContent=title;
  document.getElementById('resultBody').textContent=body;
  document.getElementById('numberPicker').classList.add('hidden');
  const btn=document.getElementById('resultContinue'); btn.textContent=buttonText; btn.classList.remove('hidden');
  btn.onclick=()=>{closeResult();btn.textContent='يلا نكمّل 😏';btn.onclick=()=>{closeResult();document.getElementById('toBreath').classList.remove('hidden')}};
  document.getElementById('resultModal').classList.add('show');
}
