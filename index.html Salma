// النتائج التفصيلية للأرقام 1–10 لم تُحسم بعد، لذلك لا نخترعها هنا.
const numberResults = {};

function showScreen(id){
  const old = document.getElementById(current);
  const next = document.getElementById(id);
  if(!next || old === next) return;
  old.classList.remove('active');
  next.classList.add('active');
  current = id;
  window.scrollTo({top:0,behavior:'smooth'});
  if(id==='letter') startLetter();
}

document.querySelectorAll('[data-next]').forEach(btn=>btn.addEventListener('click',()=>showScreen(btn.dataset.next)));

