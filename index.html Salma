function startLetter(){
  const box=document.getElementById('letterText'); box.innerHTML=''; document.getElementById('letterEnd').style.animation='none';
  finalParagraphs.forEach((text,i)=>{
    const p=document.createElement('p'); p.textContent=text; p.style.opacity='0'; p.style.transform='translateY(7px)';
    p.style.animation=`paragraphIn .85s ease ${0.7+i*1.05}s forwards`; box.appendChild(p);
  });
  const style=document.getElementById('letterParagraphStyle')||document.createElement('style'); style.id='letterParagraphStyle'; style.textContent='@keyframes paragraphIn{to{opacity:1;transform:none}}'; document.head.appendChild(style);
  document.getElementById('letterEnd').style.animation='endIn 1s ease 8.3s forwards, heartPop 2s ease-in-out 9s infinite';
  setTimeout(()=>document.getElementById('end').classList.add('active'),11000);
}

