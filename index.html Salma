// Doors
const doorGrid=document.getElementById('doorGrid');
const openedDoors=new Set();
doors.forEach((door,i)=>{
  const el=document.createElement('button'); el.type='button'; el.className='door';
  el.innerHTML=`<span>🚪 ${i+1}<br>${door.title}</span>`;
  el.addEventListener('click',()=>openDoor(i));
  doorGrid.appendChild(el);
});
function openDoor(i){
  openedDoors.add(i);
  const d=doors[i];
  document.getElementById('doorModalTitle').textContent=d.title;
  document.getElementById('doorDecor').textContent=d.icon;
  const body=document.getElementById('doorModalBody'); body.innerHTML='';
  d.body.forEach((line,j)=>{
    const p=document.createElement('p'); p.textContent=line; p.style.animation=`fade .7s ease ${j*.45}s both`; body.appendChild(p);
  });
  const card=document.getElementById('doorModalCard'); card.className='door-modal-card '+(i===3?'special4':'');
  document.getElementById('doorModal').classList.add('show'); document.getElementById('doorModal').setAttribute('aria-hidden','false');
  if(openedDoors.size===doors.length) document.getElementById('toWheel').classList.remove('hidden');
}
function closeDoor(){document.getElementById('doorModal').classList.remove('show');document.getElementById('doorModal').setAttribute('aria-hidden','true')}
document.getElementById('closeDoor').onclick=closeDoor;document.getElementById('closeDoorCta').onclick=closeDoor;document.querySelector('#doorModal .modal-backdrop').onclick=closeDoor;
document.getElementById('toWheel').addEventListener('click',()=>{closeDoor();showScreen('wheel')});

// Wheel
const wheelEl=document.getElementById('wheelEl');
const labels=['💌','🫂','🌸','🎲','💜','🎲','✨','🎁'];
labels.forEach((txt,i)=>{
  const lab=document.createElement('div'); lab.className='wheel-label'; lab.textContent=txt; lab.style.transform=`rotate(${i*45+22.5}deg) translateX(-5px)`; wheelEl.appendChild(lab);
});
let wheelRotation=0, spinning=false;
const spinBtn=document.getElementById('spinBtn');
spinBtn.addEventListener('click',spinWheel);
function spinWheel(){
  if(spinning)return; spinning=true; spinBtn.disabled=true;
  const index=Math.floor(Math.random()*8);
  const segment=360/8;
  const target=(360-(index*segment+segment/2));
  const currentMod=((wheelRotation%360)+360)%360;
  const delta=((target-currentMod)+360)%360;
  wheelRotation += 360*5 + delta;
  wheelEl.style.transform=`rotate(${wheelRotation}deg)`;
  setTimeout(()=>{spinning=false;spinBtn.disabled=false;showWheelResult(index);},5100);
}
function showWheelResult(index){
  const item=wheelItems[index];
  document.getElementById('resultIcon').textContent=item.icon;
  document.getElementById('resultLabel').textContent=`الخانة ${index+1}`;
  document.getElementById('resultTitle').textContent=item.title;
  document.getElementById('resultBody').textContent=item.body;
  const picker=document.getElementById('numberPicker'); picker.innerHTML=''; picker.classList.toggle('hidden',!item.needsNumber);
  if(item.needsNumber){
    document.getElementById('resultContinue').classList.add('hidden');
    for(let n=1;n<=10;n++){
      const b=document.createElement('button'); b.textContent=n; b.onclick=()=>chooseNumber(n); picker.appendChild(b);
    }
  }else document.getElementById('resultContinue').classList.remove('hidden');
  document.getElementById('resultModal').classList.add('show');
}
function chooseNumber(n){
  const body=document.getElementById('resultBody');
  body.textContent=numberResults[n] || `اختيارك: ${n} 🤨😂`;
  document.getElementById('numberPicker').classList.add('hidden');
  document.getElementById('resultContinue').classList.remove('hidden');
}
function closeResult(){document.getElementById('resultModal').classList.remove('show')}
document.getElementById('resultContinue').onclick=()=>{closeResult();document.getElementById('toBreath').classList.remove('hidden')};
